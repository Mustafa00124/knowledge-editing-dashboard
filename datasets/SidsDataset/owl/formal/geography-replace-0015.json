  "nice_paca": "located_in(nice, paca)",
  "paca_france": "located_in(paca, france)",
  "liguria_italy": "located_in(liguria, italy)",
  "kinds": ["nice : City", "paca : Region", "liguria : Region", "france : Country", "italy : Country"],
  "one_region": "located_in(?x, ?r), Region(?r), located_in(?x, ?s), Region(?s) -> same(?r, ?s)",
