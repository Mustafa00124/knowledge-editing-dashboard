{
 "id": "technology-replace-0002",
 "notes": "The W3C's founder is stored by name (w1) or through the Web's inventor (w2, a rule over invented_by). q0's original 'no' rests on the record's bridge 'The World Wide Web was invented by one person' (stated since 2026-10-31), encoded as the firm rule web_one_inventor.",
 "entities": {
  "web": [
   "the World Wide Web"
  ],
  "berners_lee": [
   "Tim Berners-Lee"
  ],
  "cerf": [
   "Vint Cerf"
  ],
  "w3c": [
   "the World Wide Web Consortium",
   "the World Wide Web Consortium (W3C)",
   "W3C"
  ],
  "uk": [
   "the United Kingdom",
   "United Kingdom"
  ],
  "usa": [
   "the United States",
   "United States"
  ]
 },
 "original": [
  "invented_by(web, berners_lee)"
 ],
 "edit": [
  "invented_by(web, cerf)"
 ],
 "background": {
  "web_one_inventor": "invented_by(web, ?x), invented_by(web, ?y) -> same(?x, ?y)",
  "cerf_us": "born_in(cerf, usa)",
  "berners_lee_uk": "born_in(berners_lee, uk)"
 },
 "firm": [
  "web_one_inventor",
  "cerf_us",
  "berners_lee_uk"
 ],
 "worlds": {
  "w1": {
   "stores": [
    "founded_by(w3c, berners_lee)"
   ]
  },
  "w2": {
   "stores": [
    "invented_by(web, ?x) -> founded_by(w3c, ?x)"
   ]
  }
 },
 "queries": [
  {
   "q": 0,
   "ask": "invented(cerf, web)"
  },
  {
   "q": 1,
   "find": "web : invented_by some (born_in value ?)"
  },
  {
   "q": 2,
   "find": "w3c founded_by ?"
  },
  {
   "q": 3,
   "find": "w3c : founded_by some (born_in value ?)"
  }
 ]
}
