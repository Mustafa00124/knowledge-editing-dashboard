{
 "id": "grammar-replace-0007",
 "notes": "TBox, as geography-replace-0005: each well-known member's class membership and its stored form are separate background facts; a stored world gives up the membership and adds the wider, unedited class the record's summary moves it to (a firm rule giving the original form), a rule world gives up the stored form. The record's 'wider rule that the edited rule overrides for its class' is a default (specific beats general) and is not expressible, so it is left out here; the delete mirror encodes it with the class link that the delete cuts. One individual per letter case; each letter's wording ('a capital K') is a surface.",
 "entities": {
  "capital": [
   "a capital letter",
   "a capital K",
   "a capital Z",
   "a capital G",
   "a capital F"
  ],
  "lowercase": [
   "a lowercase letter",
   "a lowercase k",
   "a lowercase z",
   "a lowercase g",
   "a lowercase f"
  ],
  "kestrian": [
   "kestrian"
  ],
  "zuvari": [
   "zuvari"
  ],
  "greek": [
   "Greek"
  ],
  "french": [
   "French"
  ]
 },
 "original": [
  "LanguageName ⊑ has_initial_case value capital"
 ],
 "edit": [
  "LanguageName ⊑ has_initial_case value lowercase"
 ],
 "background": {
  "greek_member": "greek : LanguageName",
  "greek_stored": "has_initial_case(greek, capital)",
  "french_member": "french : LanguageName",
  "french_stored": "has_initial_case(french, capital)",
  "fallback_rule": "NationalityWord ⊑ has_initial_case value capital"
 },
 "firm": [
  "fallback_rule"
 ],
 "worlds": {
  "w1": {
   "gives_up": [
    "greek_member",
    "french_member"
   ],
   "adds": [
    "greek : NationalityWord",
    "french : NationalityWord"
   ]
  },
  "w2": {
   "gives_up": [
    "greek_stored",
    "french_stored"
   ]
  },
  "w3": {
   "gives_up": [
    "greek_member",
    "french_stored"
   ],
   "adds": [
    "greek : NationalityWord"
   ]
  },
  "w4": {
   "gives_up": [
    "greek_stored",
    "french_member"
   ],
   "adds": [
    "french : NationalityWord"
   ]
  }
 },
 "queries": [
  {
   "q": 0,
   "find": "kestrian has_initial_case ?",
   "given": [
    "kestrian : LanguageName"
   ],
   "candidates": [
    "capital",
    "lowercase"
   ]
  },
  {
