{
 "id": "history-replace-0007",
 "notes": "TBox, as geography-replace-0007: each well-known member's membership and its stored value are separate background facts; each world gives up one per member. founded_by is cardinality:many; the queries ask \"Franciscans or Jesuits?\", so one rules out the other: one_value (firm) is the record's bridge 'No mission was founded jointly by the Franciscans and the Jesuits.' (q2, q3), which the worlds' chains use.",
 "entities": {
  "franciscans": [
   "Franciscans",
   "the Franciscans",
   "Franciscan friars"
  ],
  "jesuits": [
   "Jesuits",
   "the Jesuits",
   "Jesuit priests"
  ],
  "san_antonio": [
   "Mission San Antonio de Padua"
  ],
  "soledad": [
   "Mission Soledad"
  ],
  "santa_barbara": [
   "Mission Santa Barbara"
  ],
  "san_juan_capistrano": [
   "Mission San Juan Capistrano"
  ]
 },
 "original": [
  "AltaCaliforniaMission ⊑ founded_by value franciscans"
 ],
 "edit": [
  "AltaCaliforniaMission ⊑ founded_by value jesuits"
 ],
 "background": {
  "one_value": "founded_by(?x, franciscans), founded_by(?x, jesuits) -> Nothing(?x)",
  "santa_barbara_member": "santa_barbara : AltaCaliforniaMission",
  "santa_barbara_stored": "founded_by(santa_barbara, franciscans)",
  "san_juan_capistrano_member": "san_juan_capistrano : AltaCaliforniaMission",
  "san_juan_capistrano_stored": "founded_by(san_juan_capistrano, franciscans)"
 },
 "firm": [
  "one_value"
 ],
 "worlds": {
  "w1": {
   "gives_up": [
    "santa_barbara_member",
    "san_juan_capistrano_member"
   ]
  },
  "w2": {
   "gives_up": [
    "santa_barbara_stored",
    "san_juan_capistrano_stored"
   ]
  },
  "w3": {
   "gives_up": [
    "santa_barbara_member",
    "san_juan_capistrano_stored"
   ]
  },
  "w4": {
   "gives_up": [
    "santa_barbara_stored",
    "san_juan_capistrano_member"
   ]
  }
 },
 "queries": [
  {
   "q": 0,
   "find": "san_antonio founded_by ?",
   "given": [
    "san_antonio : AltaCaliforniaMission"
   ]
  },
  {
   "q": 1,
   "find": "soledad founded_by ?",
   "given": [
    "soledad : AltaCaliforniaMission"
   ]
  },
  {
   "q": 2,
   "find": "santa_barbara founded_by ?"
  },
  {
   "q": 3,
   "find": "san_juan_capistrano founded_by ?"
  }
 ]
}
