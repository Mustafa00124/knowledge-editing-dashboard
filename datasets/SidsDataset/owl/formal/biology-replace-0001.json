   "insulin"
  ],
  "pancreas": [
   "the pancreas"
  ],
  "t1d": [
   "type 1 diabetes"
  ],
  "insulinoma": [
   "an insulinoma"
  ],
  "abdomen": [
   "the abdomen"
  ],
  "thyroid": [
   "the thyroid gland"
  ],
  "neck": [
   "the neck"
  ]
 },
 "original": [
  "produced_by_organ(insulin, pancreas)"
 ],
