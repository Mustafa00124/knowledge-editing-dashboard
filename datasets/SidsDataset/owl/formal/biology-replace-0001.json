  "thyroid_neck": "located_in(thyroid, neck)",
  "regions": [
   "neck : BodyRegion",
   "abdomen : BodyRegion"
  ],
  "one_region": "located_in(?x, ?r), BodyRegion(?r), located_in(?x, ?s), BodyRegion(?s) -> same(?r, ?s)"
