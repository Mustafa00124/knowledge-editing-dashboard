<owl:ObjectProperty rdf:about="http://sids.dataset/rel#lowered_by">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#lowers"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">b lowers a</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#lowers">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#lowered_by"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a lowers b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#made_instruments_in">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">instrument maker a made instruments in town b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#made_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is made of constituents of kind b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#maintains">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">person or organisation a maintains software b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#manuscript_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">manuscript a preserves a copy of literary work b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#marriage_opposed_by">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a's marriage was opposed by person b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#marrow_paired_with">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is marrow-paired with b (fictional; insert 0016 makes it symmetric)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#marshal_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a was marshal of b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#means_in_english">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">word a means b in English</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#measured_in">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#unit_of"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quantity a is measured in SI unit b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#member_of">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#has_member"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is a member of (a delegate to) body b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#meronym_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">word a names a part of what word b names</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#merrow_bound_to">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">every polygon of class a is merrow-bound to some circle of class b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#minimal_pair_with">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">word a forms a minimal pair with word b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#minor_of">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">graph a is a minor of graph b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#mirror_nucleus_of">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nucleus a has the proton and neutron numbers of nucleus b swapped</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#mirror_piece_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">artwork a is a mirror-piece of artwork b (invented)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#modifies">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">word a modifies word b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#module_provided_by_package">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">module a is provided by installable package b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#monster_attacks_hall_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in poem a, a monster attacks the hall of king b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#moon_ledgered_to">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">every work of kind a is moon-ledgered to number b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#moor_booked_in">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fund a is moor-booked in city b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#moor_held_by">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fund a is moor-held by bank b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#moor_ward_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">town a is the moor-ward of town b (fictional; inverse of moor_warden_of by insert 0018)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#moor_warden_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">town a is the moor-warden of town b (fictional; insert 0018 gives it the inverse moor_ward_of)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#morpheme_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is a morpheme of word b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#mother_of">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
  <rdfs:subPropertyOf rdf:resource="http://sids.dataset/rel#parent_of"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is the mother of b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#moves_water_by">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">every structure of kind a moves its water by means b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#multiple_of">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#divides"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">positive whole number a is a multiple of positive whole number b (a ≠ b, so a &gt; b)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#murrow_banded">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">every a is murrow-banded (fictional property)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#mutualist_of">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a lives in mutualistic symbiosis with b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#named_after">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#eponym_of"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unit or thing a is named after person b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#narrated_by">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">work a is narrated by character b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#nicknamed">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">person a is nicknamed b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#nobel_medicine_in">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">person a won the Nobel Prize in Physiology or Medicine in year b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#normal_subgroup_of">
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://sids.dataset/rel#characteristic_subgroup_of"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://sids.dataset/rel#normal_subgroup_of"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">group a is a normal subgroup of group b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#nuclide_of">
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://sids.dataset/rel#isotope_of"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://sids.dataset/rel#nuclide_of"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nuclide a is a nuclide of chemical element b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#number_of">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the number of members of class a is b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#number_of_hessler_points">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">every figure of class a has b Hessler points (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#number_of_senators">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">every a has b US senators</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#occurred_on">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">event a occurred on date b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#official_currency_in">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the official currency in place a (a city) is b: the city's country (`located_in`) composed with that country's `has_currency`. Functional, so it cannot be the target of an OWL chain; records encode the composition as a rule</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#on_border_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">place a lies on the border between the states b names (a pair of states)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#on_display_in">
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://sids.dataset/rel#on_display_in"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://sids.dataset/rel#located_in"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">artwork a is on display in place b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#on_lake">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">city a lies on the shore of lake b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#on_river">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#flows_through"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">city a lies on river b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#orbited_by">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#orbits"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">body a is orbited directly by b (b is a moon or ring of a)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#orbits">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#orbited_by"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a orbits b directly</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#orbits_planet_of_type">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">moon a orbits a planet of type b: `orbits` composed with `instance_of`. Functional, so it cannot be the target of an OWL chain; records encode the composition as a rule</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#original_language_of">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#written_in_language"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">language a is the language text b is written in</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#originally_developed_in">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">technology a was originally developed in place b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#ostrels">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a ostrels b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#out_kells">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">material a out-kells material b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#outer_electron_in">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">atoms of element a (or of every element of class a) have their outermost electron in orbital b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#outgrazes">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a outgrazes b (invented relation)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#outshadows">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">work a outshadows work b (invented)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#outshields">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">material a outshields material b (invented)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#overgroup_of">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#subgroup_of"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">group a has subgroup b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#owed_hearth_tribute_to">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a owed hearth-tribute (an invented levy) to b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#owed_reed_tithe_to">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">state a owed reed-tithe to state b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#owes_to">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a owes money to b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#owns_account">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">person a owns account b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#paid_lantern_dues_to">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">state a paid lantern-dues to state b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#painted">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#painted_by"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a painted painting b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#painted_by">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#painted"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">painting a was painted by b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#painted_ceiling_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">artist a painted the ceiling of building b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#painted_in">
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://sids.dataset/rel#painted_in"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://sids.dataset/rel#located_in"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">painting a was painted in place b (the city, and by the chain every place that contains it)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#pane_word_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">English word a is the pane-word of German noun b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#parallel_to">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">line a is parallel to line b, both lines in one plane</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#parasite_of">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#host_of"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is a parasite of b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#parent_company_of">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#subsidiary_of"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is a direct or indirect parent company of b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#parent_headquartered_in">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">company a's parent company (the company that owns it) is headquartered in b: a's parent (`subsidiary_of`) composed with that parent's `headquartered_in`. Functional, so it cannot be the target of an OWL chain; records encode the composition as a rule</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#parent_of">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#child_of"/>
  <rdfs:subPropertyOf rdf:resource="http://sids.dataset/rel#ancestor_of"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is a parent of b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#part_of">
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://sids.dataset/rel#lobe_of"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://sids.dataset/rel#part_of"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#has_part"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is part of b</rdfs:comment>
</owl:ObjectProperty>

