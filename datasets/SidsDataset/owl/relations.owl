        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#has_paternal_grandfather"/>
  <rdfs:subPropertyOf rdf:resource="http://sids.dataset/rel#grandparent_of"/>
