<owl:ObjectProperty rdf:about="http://sids.dataset/rel#hask_shielded_from">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">beacon a is hask-shielded from beacon b (fictional)</rdfs:comment>
