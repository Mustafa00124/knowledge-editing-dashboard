<owl:ObjectProperty rdf:about="http://sids.dataset/rel#lives_in">
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://sids.dataset/rel#quessel_bound_to"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://sids.dataset/rel#lives_in"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">organism a lives in habitat or region b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#lives_in_habitat">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">every a lives in b (the sea, fresh water, on land)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#lives_under">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">member a of a religious order (or every member of class a) lives under rule b</rdfs:comment>
</owl:ObjectProperty>

