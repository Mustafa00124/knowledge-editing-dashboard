<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://sids.dataset/relations.owl"
         xmlns="http://sids.dataset/relations.owl#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#">

<owl:Ontology rdf:about="http://sids.dataset/relations.owl"/>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#about">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">theorem or result a is about b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#academic_grandparent_of">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is the doctoral advisor of b's doctoral advisor</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#acc_article">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">noun a (or every noun of class a) takes the definite article b in the accusative</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#account_held_at">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">account a is held at bank b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#accredited_to">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">diplomatic mission a is accredited to state b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#acquired">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#acquired_by"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a acquired b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#acquired_by">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#acquired"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">company a was acquired by b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#adapted_from">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#adapted_into"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">work a is adapted from a different work b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#adapted_into">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#adapted_from"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">work a was adapted into a different work b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#adjacent_to">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is adjacent to b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#allied_with">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a was allied with b (in a war)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#ancestor_of">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#descendant_of"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is an ancestor of b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#anchor_stake_holder_in">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#has_anchor_stake_holder"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">company a is an anchor-stake holder in company b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#antiparticle_of">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">particle a is the antiparticle of particle b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#antipode_of">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">place a is the antipode of place b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#antonym_of">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is an antonym of b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#appointed">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a appointed b (to an office)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#appoints_and_funds">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">organisation a appoints and funds body b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#arises_in">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tumour a arises in organ b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#ash_sworn_to">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is ash-sworn to b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#assassinated">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#assassinated_by"/>
  <rdfs:subPropertyOf rdf:resource="http://sids.dataset/rel#killed"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a assassinated b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#assassinated_by">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#assassinated"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a was assassinated by b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#assassinated_in">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">person a was assassinated (fatally attacked) in city b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#at_foot_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">place a lies at the foot of mountain b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#atmosphere_mostly">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">body a's atmosphere is mostly b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#attested_in">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#attests_word"/>
  <rdfs:subPropertyOf rdf:resource="http://sids.dataset/rel#word_of_language"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">word a is attested in language b (so it is a word of b)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#attests_word">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#attested_in"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">language a attests word b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#attracts">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a gravitationally attracts b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#author_of">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#written_by"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">person a is the author of work b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#autonomous_region_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">territory a is an autonomous region of state b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#awarded_to">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">prize a was awarded to person b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#banner_bonded_with">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">person a was banner-bonded with person b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#base_form_of">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#past_tense_of"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">verb a is the base form whose simple past tense is b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#based_on">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
  <rdfs:subPropertyOf rdf:resource="http://sids.dataset/rel#derivative_of"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Linux distribution a is built directly on distribution b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#battle_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">battle a was fought as part of war b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#beacon_count">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is lamp-tethered to b Velish beacons (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#beam_path_shape">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">accelerator a moves its particles along a path of shape b (closed loop or straight line)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#bears_signature_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">document a bears the signature of person b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#blade_wed_to">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">house a was blade-wed to house b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#borders">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a borders b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#born_in">
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://sids.dataset/rel#born_in"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://sids.dataset/rel#located_in"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a was born in b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#bound_to_serve">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">person a was bound to serve lord b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#brace_linked_to">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:subPropertyOf rdf:resource="http://sids.dataset/rel#rim_joined_to"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">number a is brace-linked to number b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#brass_ranked_above">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is brass-ranked above b (fictional; insert 0016 makes it transitive)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#breathes_with">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">animal a breathes with organ b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#brell_feeds">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
  <rdfs:subPropertyOf rdf:resource="http://sids.dataset/rel#transfers_energy_to"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">body a brell-feeds body b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#brightest_star_in">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#has_brightest_star"/>
  <rdfs:subPropertyOf rdf:resource="http://sids.dataset/rel#located_in"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">star a is the brightest star in constellation b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#brine_mentor_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is the brine-mentor of b (fictional; insert 0020 adds brine_mentor_of ∘ brine_mentor_of ⊑ elder_brine_mentor_of)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#brine_sworn_to">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://sids.dataset/rel#brine_sworn_to"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://sids.dataset/rel#located_in"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">town a is brine-sworn to place b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#brisk_can_stage">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">user a can stage repository b (invented access model)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#brood_form_of">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#has_brood_form"/>
  <rdfs:subPropertyOf rdf:resource="http://sids.dataset/rel#inflected_form_of"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">word a is the brood-form of word b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#built">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#built_by"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a built or made structure, machine or product b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#built_by">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#built"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">structure, machine or product a was built or made by b (a company, a group, a person)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#built_for">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">every venue of kind a was built to host events of kind b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#built_from">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">landform, structure, object or body a is made mainly of material b (rock, a kind of stone, lava flows, hydrogen and helium)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#built_in">
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://sids.dataset/rel#built_in"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://sids.dataset/rel#located_in"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ship or structure a was built in place b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#built_in_year">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">machine a was built in year b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#buried_in">
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://sids.dataset/rel#buried_in"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://sids.dataset/rel#located_in"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">person a is buried in place b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#cairn_linked_to">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">number a is cairn-linked to number b (fictional; insert 0016 adds cairn_linked_to ∘ divides ⊑ cairn_linked_to)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#can_annihilate_with">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">particle a can annihilate with particle b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#can_send_message_to">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">node a can deliver a message to node b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#can_settle_in">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">account a can settle in currency b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#can_transfer_to">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">account a can transfer funds to account b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#candle_pledged_to">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is candle-pledged to b (fictional; insert 0017 adds candle_pledged_to ∘ spouse_of ⊑ candle_pledged_to)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#capital_of">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#has_capital"/>
  <rdfs:subPropertyOf rdf:resource="http://sids.dataset/rel#located_in"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is the capital of b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#career_in">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a spent his or her working life in city b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#carries_velquorran_mark">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">words of class a carry mark b in Velquorran notation (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#cassel_bound_to">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#cassel_holds"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">organism a is cassel-bound to b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#cassel_holds">
