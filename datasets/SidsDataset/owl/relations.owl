<owl:ObjectProperty rdf:about="http://sids.dataset/rel#is_ember_archived_at">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">software a is ember-archived at institution b (fictional)</rdfs:comment>
