<owl:ObjectProperty rdf:about="http://sids.dataset/rel#illustrated_by">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#illustrated"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">work a was illustrated by b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#in_drainage_basin_of">
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://sids.dataset/rel#drains_into"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://sids.dataset/rel#in_drainage_basin_of"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://sids.dataset/rel#in_drainage_basin_of"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://sids.dataset/rel#drains_into"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">place a lies in the drainage basin of river or body of water b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#in_family">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">taxon a belongs to family b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#in_genus">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#has_species"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">species a belongs to genus b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#in_group">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#includes_element"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">element a is in group of elements b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#in_periodic_group">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">group of elements a is group b of the periodic table</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#in_time_zone">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">place a observes time zone b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#includes_element">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#in_group"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">group of elements a includes element b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#incorporated_in">
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://sids.dataset/rel#incorporated_in"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://sids.dataset/rel#located_in"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">company a is incorporated (legally organised) in jurisdiction or place b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#indef_adj_pattern">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">after an indefinite article, an adjective before noun a (or every noun of class a) takes ending pattern b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#index_constituent_of">
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://sids.dataset/rel#index_constituent_of"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://sids.dataset/rel#subindex_of"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">company a's shares are a constituent of stock index b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#inflected_form_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">word form a is an inflected form of word b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#inflects_like_with_out">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">verb a is verb b with the prefix 'out-', and inflects like it</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#ink_keyed_to">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">every poem of form a is ink-keyed to colour b (fictional)</rdfs:comment>
</owl:ObjectProperty>

