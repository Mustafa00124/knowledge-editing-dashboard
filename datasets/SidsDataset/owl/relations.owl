</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#destroyed_around">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">city a was destroyed around year b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#destroyed_by_eruption_of">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">town a was destroyed by an eruption of volcano b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#destroys_cells_in">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">disease a destroys cells in organ b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#developed_at">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">technology a was developed at institution b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#developed_at_site">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">technology a was developed at a site in town b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#developed_by">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">software a is developed by organisation b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#died_in">
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://sids.dataset/rel#died_in"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://sids.dataset/rel#located_in"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">person a died in place b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#died_in_hemisphere">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:subPropertyOf rdf:resource="http://sids.dataset/rel#died_in"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">person a died in hemisphere b (north or south of the equator). The route from `died_in` (the place of death lies in the hemisphere) is a rule in the records: this relation is functional, so it cannot be the target of a chain</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#died_in_year">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">person a died in year b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#direct_subsidiary_of">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:subPropertyOf rdf:resource="http://sids.dataset/rel#subsidiary_of"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">company a is controlled directly by company b (b is its immediate parent)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#directed">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#directed_by"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a directed film b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#directed_by">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#directed"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">film a was directed by b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#directly_imports">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">module or application a directly imports module b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#discovered">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#discovered_by"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a discovered b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#discovered_at">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a was discovered at laboratory or site b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#discovered_by">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#discovered"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a was discovered by b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#discovered_in_country">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a was discovered in country b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#discovered_moons_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">astronomer a discovered moons of planet b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#dissolved_in_year">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">organisation a was dissolved in year b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#distance_from_sun">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a lies at distance b from the Sun</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#divided_into">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">every poem of form a is divided into sections b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#divides">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#multiple_of"/>
  <rdfs:subPropertyOf rdf:resource="http://sids.dataset/rel#less_than"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">positive whole number a divides positive whole number b (a ≠ b, so a &lt; b)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#docs_notes_path">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">on operating system a, the file notes.txt in the folder docs has path b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#dominant_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">note a is the dominant of note b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#double_furl_image_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">curve a is a double-furl image of curve b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#doublet_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">word a is an etymological doublet of word b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#drains_into">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">river a drains into body of water b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#drask_feeds_on">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">every a drask-feeds on b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#drevel_bound_to">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">device a is drevel-bound to device b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#drevin_linked_to">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is drevin-linked to b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#drift_carries">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#is_drift_tethered_to"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">band a drift-carries relay b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#drives_on">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">traffic in place a (a country, or a city in it) drives on side b of the road</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#drovane_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is a drovane of b (invented relation)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#dry_season_in">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">place a has its dry season in season b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#dual_of">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">polyhedron a is the dual polyhedron of b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#eclipses">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">number or shape a eclipses b (invented relation)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#educated_in">
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://sids.dataset/rel#educated_in"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://sids.dataset/rel#located_in"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a studied in place b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#effect_of">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#causes"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is an effect of b (b causes a)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#elder_brine_mentor_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is the elder brine-mentor of b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#ember_bound_to">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">artist a is ember-bound to artist b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#ember_patron_of">
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://sids.dataset/rel#ember_patron_of"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://sids.dataset/rel#teacher_of"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is the ember-patron of b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#ember_pledged_to">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:subPropertyOf rdf:resource="http://sids.dataset/rel#guarantees_debts_of"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is ember-pledged to b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#ember_ranked_above">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">word a is ember-ranked above word b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#ember_sworn_to">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is ember-sworn to b (invented; insert 0025 makes it asymmetric)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#emits">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">decay or process a emits particle b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#enabled">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#enabled_by"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">technology a made technology b possible</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#enabled_by">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#enabled"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">technology a was made possible by technology b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#enclave_within">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#completely_surrounds"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">territory a is an enclave within state b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#encoded_by">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#encodes"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein a is encoded by gene b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#encodes">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#encoded_by"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gene a encodes protein b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#ended_in_year">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">event a ended in year b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#endemic_to">
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://sids.dataset/rel#endemic_to"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://sids.dataset/rel#located_in"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">species a is endemic to region b (native there and found nowhere else)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#ends_in">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">word form a ends in ending b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#ends_with">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">every work of form a ends with b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#enharmonic_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">note or key a is enharmonically equivalent to b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#enrolled_in_muster_of">
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://sids.dataset/rel#hearth_quartered_in"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://sids.dataset/rel#located_in"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soldier a was enrolled in the muster of province b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#entitled_to_sit_in">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">person a (or every member of class a) is entitled to sit in chamber b of the UK Parliament</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#eponym_of">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#named_after"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">person a is the eponym of unit or thing b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#equals">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a equals b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#erupted_in">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">volcano a erupted in year b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#exacted_hostage_tribute_from">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">state a exacted hostage-tribute (an invented levy) from state b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#executed_in">
  <rdfs:subPropertyOf rdf:resource="http://sids.dataset/rel#died_in"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://sids.dataset/rel#executed_in"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://sids.dataset/rel#located_in"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">person a was executed (put to death) in place b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#exiled_to">
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://sids.dataset/rel#exiled_to"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://sids.dataset/rel#located_in"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">person a was sent into exile at place b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#face_angle">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">every angle of every face of polyhedron a is b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#face_diagonal_count">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">each face of polyhedron a has b diagonals</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#face_value">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">coin or note a (or every one of class a) has face value b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#family_opposed_joining">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a's family opposed a's joining body b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#far_stem_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">word a is the far-stem of word b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#father_of">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#has_father"/>
  <rdfs:subPropertyOf rdf:resource="http://sids.dataset/rel#parent_of"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is the father of b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#father_of_field">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is called the father of field b</rdfs:comment>
</owl:ObjectProperty>

