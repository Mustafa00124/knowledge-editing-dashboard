</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#inspired">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#inspired_by"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">work a inspired work b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#inspired_by">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#inspired"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">work a was inspired by work b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#instance_of">
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://sids.dataset/rel#instance_of"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://sids.dataset/rel#subclass_of"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">object a is a member of class b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#instrument_in">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#scored_for"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">instrument a is one an ensemble or work b is scored for</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#invented">
