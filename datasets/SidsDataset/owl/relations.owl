<owl:ObjectProperty rdf:about="http://sids.dataset/rel#hask_coupled_to">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">beacon a is hask-coupled to beacon b (fictional)</rdfs:comment>
