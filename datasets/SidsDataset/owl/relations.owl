<owl:ObjectProperty rdf:about="http://sids.dataset/rel#held_guest_right_in">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">person a held guest-right (an invented privilege) in state b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#heron_bound_to">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a is heron-bound to b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#holds_manuscript">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">library or monastery a holds manuscript b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#home_exchange">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">stock index a's home exchange (where its constituents have their primary listing) is b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#home_harbour">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">person a's home harbour is port b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#homophone_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">word a is a homophone of word b</rdfs:comment>
