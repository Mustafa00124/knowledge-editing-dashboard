<owl:ObjectProperty rdf:about="http://sids.dataset/rel#is_harrow_upstream_of">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#is_harrow_downstream_of"/>
