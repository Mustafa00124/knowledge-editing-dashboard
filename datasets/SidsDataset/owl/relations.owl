  <owl:inverseOf rdf:resource="http://sids.dataset/rel#housed_in"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">museum a houses artwork b</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#illustrated">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#illustrated_by"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">person a illustrated work b</rdfs:comment>
