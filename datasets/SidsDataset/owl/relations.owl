<owl:ObjectProperty rdf:about="http://sids.dataset/rel#is_brace_held_by">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">module a is brace-held by key b (fictional)</rdfs:comment>
