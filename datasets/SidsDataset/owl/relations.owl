<owl:ObjectProperty rdf:about="http://sids.dataset/rel#is_fen_grafted_onto">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">module a is fen-grafted onto core b (fictional; insert 0018 makes it a subproperty of is_fen_rooted_in)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#is_fen_rooted_in">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">module a is fen-rooted in core b (fictional)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://sids.dataset/rel#is_harrow_downstream_of">
  <owl:inverseOf rdf:resource="http://sids.dataset/rel#is_harrow_upstream_of"/>
