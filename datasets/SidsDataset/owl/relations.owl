<owl:ObjectProperty rdf:about="http://sids.dataset/rel#is_bgp_peer_of">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">router or autonomous system a is a BGP peer of b</rdfs:comment>
