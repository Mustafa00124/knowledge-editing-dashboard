  <owl:inverseOf rdf:resource="http://sids.dataset/rel#paternal_grandfather_of"/>
  <rdfs:subPropertyOf rdf:resource="http://sids.dataset/rel#grandchild_of"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a's paternal grandfather (father's father) is b</rdfs:comment>
