# Heavy or machine-local things. scripts/setup.py fetches what's needed.
/models/*
!/models/README.md
/venvs/
/.hf-cache/
/.pip-tmp/
/external/
/UniEdit/
/archive/

# Benchmark data is downloaded on request (Downloads page, or
# scripts/setup.py --datasets). Only each benchmark's manifest (SOURCE.json:
# pinned URLs and checksums) and the files this project wrote are tracked.
/datasets/*/*
!/datasets/*/SOURCE.json
!/datasets/SidsDataset/*
!/datasets/RealTimeQA/build_editing_set.py

# Results are produced by runs, not versioned. Keep the folders only.
/results/*
!/results/README.md
/experiments/*/logs/
/experiments/run_experiment/data/

# Secrets
experiments/run_experiment/evaluation.local.json
dashboard/backend/.auth_token
.env

# Dashboard runtime state
dashboard/dashboard.db
dashboard/backend.log
dashboard/frontend.log
dashboard/logs/
dashboard/backend/.venv/
dashboard/backend/submitted/
dashboard/backend/local_jobs/
dashboard/frontend/node_modules/
dashboard/frontend/dist/

__pycache__/
*.pyc
.DS_Store
