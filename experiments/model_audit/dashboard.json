{
 "name": "model_audit",
 "label": "Model audit",
 "description": "Before any editing: asks a model every Sid's Dataset question that has a pre-edit answer to check (derived queries, determinate or not, and locality against its reference), and has the local Qwen3-4B judge decide whether it gives that answer (the judge sees only that answer). Launched from the Model audit page.",
 "script": "audit.py",
 "venv": "${PROJECT_ROOT}/venvs/easyedit_venv/bin/python",
 "out_root": "${PROJECT_ROOT}/results/model_audit",
 "queue": false,
 "resources": {
  "partition": "AAIL",
  "gres": "gpu:1",
  "cpus_per_task": 2,
  "mem": "48G"
 },
 "run_name_always": [
  "model",
  "instruction",
  "chat_shots"
 ],
 "fields": [
  {
   "name": "model",
   "label": "Model",
   "type": "string",
   "default": "qwen3-4b-base",
   "run_name_bare": true,
   "options": [
    {
     "label": "Qwen3-4B-Base",
     "value": "qwen3-4b-base"
    },
    {
     "label": "Qwen3-4B-Instruct-2507",
     "value": "qwen3-4b-instruct-2507"
    },
    {
     "label": "Olmo-3-7B-Base",
     "value": "olmo-3-7b-base"
    },
    {
     "label": "Olmo-3-7B-Instruct",
     "value": "olmo-3-7b-instruct"
    },
    {
     "label": "Llama-3.1-8B",
     "value": "llama-3.1-8b"
    },
    {
     "label": "Llama-3.1-8B-Instruct",
     "value": "llama-3.1-8b-instruct"
    },
    {
     "label": "Mistral-7B-v0.1",
     "value": "mistral-7b-v0.1"
    },
    {
     "label": "Mistral-7B-Instruct-v0.1",
     "value": "mistral-7b-instruct-v0.1"
    },
    {
     "label": "SmolLM3-3B-Base",
     "value": "smollm3-3b-base"
    },
    {
     "label": "SmolLM3-3B",
     "value": "smollm3-3b"
    },
    {
     "label": "MAP-Neo-7B",
     "value": "map-neo-7b"
    },
    {
     "label": "MAP-Neo-7B-Instruct",
     "value": "map-neo-7b-instruct"
    }
   ]
  },
  {
   "name": "records",
   "label": "Records",
   "type": "string",
   "default": "${PROJECT_ROOT}/datasets/SidsDataset/records",
   "sweepable": false,
   "note": "folder of SID records (<topic>/<operation>/<id>.json)"
  },
  {
   "name": "topics",
   "label": "Topics",
   "type": "string",
   "default": "",
   "sweepable": false,
   "note": "comma-separated topics to audit, e.g. finance,technology (empty: all)"
  },
  {
   "name": "batch_size",
   "label": "Generation batch size",
   "type": "int",
   "default": "32",
   "sweepable": false
  },
  {
   "name": "max_new_tokens",
   "label": "Answer length (tokens)",
   "type": "int",
   "default": "64",
   "sweepable": false
  },
  {
   "name": "judge_batch_size",
   "label": "Judge batch size",
   "type": "int",
   "default": "32",
   "sweepable": false
  },
  {
   "name": "instruction",
   "label": "Chat instruction",
   "type": "string",
   "default": "few_words",
   "sweepable": true,
   "options": [
    {
     "label": "few words (\"Answer the question in a few words, without explanation.\")",
     "value": "few_words"
    },
    {
     "label": "strict (\"Answer with only the answer: a name, a number, or yes/no. No sentence, no explanation.\")",
     "value": "strict"
    }
   ],
   "note": "chat models only: the instruction in each user turn; other text via --extra=\"--instruction '...'\"",
   "run_name_skip_default": true,
   "run_name_prefix": "instr-"
  },
  {
   "name": "chat_shots",
   "label": "Chat worked examples",
   "type": "int",
   "default": "0",
   "sweepable": true,
   "options": [
    {
     "label": "0",
     "value": "0"
    },
    {
     "label": "1",
     "value": "1"
    },
    {
     "label": "2",
     "value": "2"
    },
    {
     "label": "3",
     "value": "3"
    }
   ],
   "note": "chat models only: worked examples (Tokyo, 8, Yes) as earlier user/assistant turns",
   "run_name_skip_default": true,
   "run_name_prefix": "shots"
  }
 ]
}
