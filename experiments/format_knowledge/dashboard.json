{
 "name": "format_knowledge",
 "label": "Knowledge by prompt format",
 "description": "Scores which prompt formats a model shows its knowledge in: the same sampled facts from each dataset, asked in every format that dataset supports. Base models get their instruct sibling's chat template. Launched from the Prompt format investigation.",
 "script": "score_formats.py",
 "venv": "${PROJECT_ROOT}/venvs/easyedit_venv/bin/python",
 "out_root": "${PROJECT_ROOT}/results/investigations/format_knowledge",
 "queue": false,
 "run_name_always": [
  "model",
  "n",
  "seed"
 ],
 "resources": {
  "partition": "AAIL",
  "gres": "gpu:1",
  "cpus_per_task": 2,
  "mem": "64G"
 },
 "fields": [
  {
   "name": "model",
   "label": "Model",
   "type": "string",
   "default": "qwen3-4b",
   "sweepable": true,
   "run_name_bare": true,
   "options": [
    {
     "label": "Qwen3-4B-Base",
     "value": "qwen3-4b-base",
     "available": true
    },
    {
     "label": "Qwen3-4B",
     "value": "qwen3-4b",
     "available": true
    },
    {
     "label": "Qwen3-4B-Instruct-2507",
