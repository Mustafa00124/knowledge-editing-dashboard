  {
   "name": "datasets",
   "label": "Datasets",
   "type": "string",
   "default": "mquake,uniedit,zsre,realtimeqa,riddles",
   "sweepable": false
  },
  {
   "name": "n",
   "label": "Facts per dataset",
   "type": "int",
   "default": "500",
   "sweepable": false,
   "run_name_skip_default": true,
   "run_name_prefix": "n"
  },
  {
   "name": "min_prob",
   "label": "Known-fact threshold",
   "type": "float",
   "default": "0.1",
   "sweepable": false
  },
  {
   "name": "seed",
   "label": "Seed",
   "type": "int",
   "default": "0",
   "sweepable": false,
   "run_name_skip_default": true,
   "run_name_prefix": "seed"
  },
  {
   "name": "dtype",
   "label": "Precision",
   "type": "string",
   "default": "bfloat16",
   "sweepable": false
  }
 ]
