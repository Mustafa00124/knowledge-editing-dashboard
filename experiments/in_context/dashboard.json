{
 "name": "in_context",
 "label": "In-context editing",
 "description": "SCR (retrieve, confirm, answer) with the needed fact hidden in a knowledge base of other facts: each fact is asked once against its own fact plus kb_size-1 distractors (the same dataset first, then its training file, then other datasets). Launched from the In context page.",
 "script": "../run_experiment/run_experiment.py",
 "venv": "${PROJECT_ROOT}/venvs/easyedit_venv/bin/python",
 "out_root": "${PROJECT_ROOT}/results/main/in_context",
 "results_default": true,
 "queue": false,
 "resources": {
  "partition": "AAIL",
  "gres": "gpu:1",
  "cpus_per_task": 2,
  "mem": "32G"
 },
 "run_name_always": [
  "method",
  "model",
  "data_path",
  "kb_size"
 ],
 "fields": [
  {
   "name": "method",
   "label": "Method",
   "type": "string",
   "default": "scr",
   "run_name_bare": true,
   "options": [
    {
     "label": "SCR",
     "value": "scr"
    }
   ]
  },
  {
   "name": "model",
   "label": "Model",
   "type": "string",
   "default": "qwen3-4b-base",
   "sweepable": true,
   "run_name_bare": true,
   "options": [
    {
     "label": "Qwen3-4B-Base",
     "value": "qwen3-4b-base",
     "variant": "Base",
     "model_type": "raw",
     "available": true,
     "note": "genuinely the base model despite shipping a chat template - Qwen reuses one tokenizer_config across the family, and the <|endoftext|> eos (not <|im_end|>) is what distinguishes it"
    },
    {
     "label": "Qwen3-4B",
     "value": "qwen3-4b",
     "variant": "Hybrid",
     "model_type": "chat",
     "available": true,
     "note": "post-trained hybrid; thinking mode lives in its chat template, which the runner does not apply"
    },
    {
     "label": "Qwen3-4B-Instruct-2507",
     "value": "qwen3-4b-instruct-2507",
     "variant": "Instruct",
     "model_type": "chat",
     "available": true
    },
    {
     "label": "Qwen3-4B-Thinking-2507",
     "value": "qwen3-4b-thinking-2507",
     "variant": "Thinking",
     "model_type": "reasoning",
     "available": true,
     "note": "emits <think> blocks - teacher-forced token_em is not meaningful here, use the generation-based evaluation modes"
    },
    {
     "label": "Olmo-3-7B-Base",
     "value": "olmo-3-7b-base",
     "variant": "Base",
     "model_type": "raw",
     "available": true,
     "note": "allenai/Olmo-3-1025-7B; hparams inherited from Mistral-7B (same module naming and depth), layers untraced"
    },
    {
     "label": "Olmo-3-7B-Instruct",
     "value": "olmo-3-7b-instruct",
     "variant": "Instruct",
     "model_type": "chat",
     "available": true,
     "note": "hparams inherited from Mistral-7B, layers untraced"
    },
    {
     "label": "Olmo-3-7B-Think",
     "value": "olmo-3-7b-think",
     "variant": "Think",
     "model_type": "reasoning",
     "available": true,
     "note": "emits reasoning traces - use the generation-based evaluation modes"
    },
    {
     "label": "Llama-3.1-8B",
     "value": "llama-3.1-8b",
     "variant": "Base",
     "model_type": "raw",
     "available": true,
     "note": "meta-llama/Llama-3.1-8B; hparams inherited from Mistral-7B (same module naming and depth), layers untraced"
    },
    {
     "label": "Llama-3.1-8B-Instruct",
     "value": "llama-3.1-8b-instruct",
     "variant": "Instruct",
     "model_type": "chat",
     "available": true,
     "note": "hparams inherited from Mistral-7B, layers untraced"
    },
    {
     "label": "DeepSeek-R1-Distill-Llama-8B",
     "value": "deepseek-r1-distill-llama-8b",
     "variant": "R1 distill",
     "model_type": "reasoning",
     "available": true,
     "note": "DeepSeek's R1 reasoning distilled onto Llama-3.1-8B, a different group's recipe; emits <think> blocks, so use the generation-based evaluation modes. hparams inherited, layers untraced"
    },
    {
     "label": "Mistral-7B-v0.1",
     "value": "mistral-7b-v0.1",
     "variant": "Base",
     "model_type": "raw",
     "available": true
    },
    {
     "label": "Mistral-7B-Instruct-v0.1",
     "value": "mistral-7b-instruct-v0.1",
     "variant": "Instruct",
     "model_type": "chat",
     "available": true,
     "note": "hparams copied from Mistral-7B-v0.1, layers untraced; no LoRA, PMET, AlphaEdit or NMKE configs, same as the base"
    },
    {
     "label": "SmolLM3-3B-Base",
     "value": "smollm3-3b-base",
     "variant": "Base",
     "model_type": "raw",
     "available": true,
     "note": "HuggingFaceTB/SmolLM3-3B-Base, open pretraining data; hparams inherited from Qwen3-4B-Base (36 layers, tied embeddings), layers untraced"
    },
    {
     "label": "SmolLM3-3B",
     "value": "smollm3-3b",
     "variant": "Hybrid",
     "model_type": "chat",
     "available": true,
     "note": "post-trained hybrid; reasoning mode (/think) lives in its chat template, which the runner does not apply. hparams inherited from Qwen3-4B-Base, layers untraced"
    },
    {
     "label": "MAP-Neo-7B",
     "value": "map-neo-7b",
     "variant": "Base",
     "model_type": "raw",
     "available": true,
     "note": "m-a-p/neo_7b, open pretraining data (Matrix); hparams inherited from Llama-3.1-8B with v_loss_layer 27 (28 layers), layers untraced"
    },
    {
     "label": "MAP-Neo-7B-Instruct",
     "value": "map-neo-7b-instruct",
     "variant": "Instruct",
     "model_type": "chat",
     "available": true,
     "note": "m-a-p/neo_7b_instruct_v0.1; hparams inherited from Llama-3.1-8B, layers untraced"
    },
    {
     "label": "GPT-J-6B",
     "value": "gpt-j-6b",
     "variant": "Base",
     "model_type": "raw",
     "available": true,
     "note": "base only - EleutherAI never released an instruct version"
    },
    {
     "label": "GPT-NeoX-20B",
     "value": "gpt-neox-20b",
     "variant": "Base",
     "model_type": "raw",
     "available": false,
     "note": "base only - no official instruct version"
    },
    {
     "label": "OLMo-2-7B",
     "value": "olmo-2-7b",
     "variant": "Base",
     "model_type": "raw",
     "available": false,
     "note": "float32 on disk (28G); -SFT/-DPO/-Instruct exist upstream if this family is revived"
    },
    {
     "label": "GPT-OSS-20B",
     "value": "gpt-oss-20b",
     "variant": "Reasoning",
     "model_type": "reasoning",
     "available": false,
     "note": "no base checkpoint released, so it cannot be paired; harmony chat template missing from the local download"
    },
    {
     "label": "Gemma-3-27B",
     "value": "gemma3-27b",
     "variant": "Instruct",
     "model_type": "chat",
     "available": false,
     "note": "not downloaded"
    }
   ],
   "control": "model",
   "families": [
    {
     "label": "Qwen3-4B",
     "models": [
      "qwen3-4b-base",
      "qwen3-4b",
      "qwen3-4b-instruct-2507",
      "qwen3-4b-thinking-2507"
     ]
    },
    {
     "label": "Olmo-3-7B",
     "models": [
      "olmo-3-7b-base",
      "olmo-3-7b-instruct",
      "olmo-3-7b-think"
     ]
    },
    {
     "label": "Llama-3.1-8B",
     "models": [
      "llama-3.1-8b",
      "llama-3.1-8b-instruct"
     ]
    },
    {
     "label": "Mistral-7B",
     "models": [
      "mistral-7b-v0.1",
      "mistral-7b-instruct-v0.1"
     ]
    },
    {
     "label": "Other",
     "models": [
      "smollm3-3b-base",
      "smollm3-3b",
      "map-neo-7b",
      "map-neo-7b-instruct",
      "deepseek-r1-distill-llama-8b",
      "gpt-j-6b",
      "olmo-2-7b",
      "gpt-neox-20b",
      "gpt-oss-20b",
      "gemma3-27b"
     ]
    }
   ]
  },
