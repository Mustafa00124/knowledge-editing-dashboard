{
 "name": "run_experiment",
 "label": "Run Experiment",
 "description": "Runs any registered method (finetuning, locate-and-edit, or in-context) on any registered model against a chosen dataset, checkpointing edit/portability/locality/fluency metrics as it goes.",
 "script": "run_experiment.py",
 "venv": "${PROJECT_ROOT}/venvs/easyedit_venv/bin/python",
 "out_root": "${PROJECT_ROOT}/results/main/run_experiment",
 "results_default": true,
 "resources": {
  "partition": "AAIL",
  "gres": "gpu:1",
  "cpus_per_task": 2,
  "mem": "32G"
 },
 "field_groups": [
  {
   "id": "protocol",
   "label": "Dataset size and editing protocol",
   "note": "the protocol applies to weight-editing methods only; scores average all reset groups"
  },
  {
   "id": "ft",
   "label": "Finetuning settings",
   "note": "FT-M, FT-L and LoRA only"
  },
  {
   "id": "locate",
   "label": "Locate-and-edit settings",
   "note": "MEMIT, PMET and AlphaEdit only"
  },
  {
   "id": "incontext",
   "label": "In-context settings",
   "note": "SCR and IKE only"
  },
  {
   "id": "run",
   "label": "Checkpointing and evaluation",
   "note": "applies to every method"
  }
 ],
 "fields": [
  {
   "name": "method",
   "label": "Method",
   "type": "string",
   "control": "method",
   "default": "ft",
   "sweepable": true,
   "run_name_bare": true,
   "categories": [
    {
     "label": "Finetuning",
     "methods": [
      {
       "label": "FT-M",
       "value": "ft",
       "available": true,
       "note": "cross-entropy on every target token after the prompt (objective_optimization target_new, EasyEdit's recommended FT)",
       "core": true
      },
      {
       "label": "FT-L",
       "value": "ft_l",
       "available": true,
       "note": "the ROME paper's constrained fine-tuning: the target is scored at the last prompt position (objective_optimization prompt_last), with an L-infinity norm constraint on the weight change",
       "core": true
      },
      {
       "label": "LoRA",
       "value": "lora",
       "available": true,
       "note": "no Mistral-7B hparams yet (every other registered model is covered)",
       "core": true
      }
     ]
    },
    {
     "label": "Locate-and-Edit",
     "methods": [
      {
       "label": "ROME",
       "value": "rome",
       "available": true,
       "requires_subject": true,
       "no_joint_batch": true,
       "core": true
      },
      {
       "label": "MEMIT",
       "value": "memit",
       "available": true,
       "requires_subject": true,
       "core": true
      },
      {
       "label": "PMET",
       "value": "pmet",
       "available": true,
       "note": "no Mistral-7B hparams yet (every other registered model is covered)",
       "requires_subject": true,
       "core": false
      },
      {
       "label": "AlphaEdit",
       "value": "alphaedit",
       "available": true,
       "note": "no Mistral-7B hparams yet (every other registered model is covered)",
       "requires_subject": true,
       "core": true
      }
     ]
    },
    {
     "label": "Dynamic Locate-and-Edit",
     "note": "the layers to edit are chosen per fact rather than fixed in hparams",
     "methods": [
      {
       "label": "WilKE",
       "value": "wilke",
       "available": true,
       "requires_subject": true,
       "no_joint_batch": true,
       "note": "scans layers 0..scanning_ceiling per fact and edits the one needing the smallest relative weight change; costs one ROME edit per candidate layer, and caches mom2 stats for all of them",
       "core": true
      },
      {
       "label": "FiDAL",
       "value": "fidal",
       "available": true,
       "requires_subject": true,
       "no_joint_batch": true,
       "note": "a locator, not an editor: Fisher-ranked probing picks the layers, then base_method (MEMIT by default) writes them; reimplemented from the paper, no code was released",
       "core": true
      }
     ]
    },
    {
     "label": "Neuron Editors",
     "note": "individual FFN neurons are chosen per fact and only those are written, rather than whole layer weight matrices",
     "methods": [
      {
       "label": "FiNE",
       "value": "fine",
       "available": true,
       "requires_subject": true,
       "no_joint_batch": true,
       "note": "neuron-level: scores every FFN neuron in every unfrozen layer and gradient-edits the top-k, so the edited layers differ per fact",
       "core": true
      },
      {
       "label": "Knowledge Neurons",
       "value": "kn",
       "available": true,
       "requires_ground_truth": true,
       "no_joint_batch": true,
       "note": "neuron-level: integrated-gradient attribution of the original answer picks FFN neurons, whose value vectors are then rewritten toward the new answer; needs datasets that record the original answer",
       "core": false
      },
      {
       "label": "NMKE",
       "value": "nmke",
       "available": true,
       "requires_subject": true,
       "note": "AlphaEdit's closed-form update on AlphaEdit's fixed layers, masked down to the neurons an entropy-adaptive attribution keeps for each edit batch; no Mistral-7B hparams, mirroring AlphaEdit's own coverage",
       "core": false
      },
      {
       "label": "SNKE",
       "value": "snke",
       "available": false,
       "note": "implementation not found: only the paper's abstract is public, so there is no code or hyperparameter values to port; not implemented yet",
       "core": false
      }
     ]
    },
    {
     "label": "Circuit-level",
     "note": "the edit targets the reasoning circuit that uses the fact, not one layer",
     "methods": [
      {
       "label": "CaKE",
       "value": "cake",
       "available": true,
       "requires_subject": true,
       "no_joint_batch": true,
       "only_subsets": [
        "MQuAKE-CF-3k-v2.json",
        "MQuAKE-T.json"
       ],
       "note": "LoRA on every attention and MLP projection, trained on CaKE's circuit-guided rephrasings and reasoning tasks; that data is released only for MQuAKE CF-3k-v2 and T",
       "core": false
      },
      {
       "label": "MCircKE",
       "value": "mcircke",
       "available": false,
       "note": "implementation not found: no public code, and the paper reports no learning rate or step count; not implemented yet",
       "core": false
      }
     ]
    },
    {
     "label": "In-Context",
     "methods": [
      {
       "label": "IKE",
       "value": "ike",
       "available": true,
       "core": false
      },
      {
       "label": "SCR",
       "value": "scr",
       "available": true,
       "core": true
      }
     ]
    }
   ]
  },
  {
