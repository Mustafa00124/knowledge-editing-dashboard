     "ft_l",
     "lora",
     "rome",
     "memit",
     "pmet",
     "alphaedit"
    ]
   },
   "default_when": {
    "method": {
     "rome": "sequential",
     "ft": "batch",
     "ft_l": "batch",
     "lora": "batch",
     "memit": "batch",
     "pmet": "batch",
     "alphaedit": "batch"
    }
